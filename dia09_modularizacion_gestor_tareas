      "source": [
        "def mostrar_menu():\n",
        "  print(\"\\n Gestor de tareas\")\n",
        "  print(\"1. Añadir tareas\")\n",
        "  print(\"2. Mostrar tareas\")\n",
        "  print(\"3. Salir\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def añadir_tarea(tareas):\n",
        "  titulo = input(\"Título de la tarea: \")\n",
        "  estado = input(\"¿Está completada? (si/no): \").lower()\n",
        "\n",
        "  tarea = {\n",
        "      \"titulo\": titulo,\n",
        "      \"estado\": estado\n",
        "  }\n",
        "\n",
        "  tareas.append(tarea)\n",
        "  print(\"Tarea añadida correctamente\")"
      ],
      "metadata": {
        "id": "gFyNPGn8fArf"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def mostrar_tareas(tareas):\n",
        "  if len(tareas) == 0:\n",
        "    print(\"No hay tareas\")\n",
        "  else:\n",
        "    print(\"\\nLista de tareas:\")\n",
        "    for i, tarea in enumerate(tareas, start=1):\n",
        "      print(i, \"-\", tarea[\"titulo\"], \"| Estado:\", tarea[\"estado\"])"
      ],
      "metadata": {
        "id": "OrjPzNQ7hrQE"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "tareas = []\n",
        "\n",
        "opcion = \"\"\n",
        "\n",
        "while opcion != \"3\":\n",
        "  mostrar_menu()\n",
        "  opcion = input(\"Elige una opción: \")\n",
        "\n",
        "  if opcion == \"1\":\n",
        "    añadir_tarea(tareas)\n",
        "  elif opcion == \"2\":\n",
        "    mostrar_tareas(tareas)\n",
        "  elif opcion == \"3\":\n",
        "    print(\"¡Hasta luego!\")\n",
        "  else:\n",
        "    print(\"Opción no válida\")"
      ],
